    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.4",
    "mongoose": "^9.2.1",
    "pdfkit": "^0.17.2"
  }
}
